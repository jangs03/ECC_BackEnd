## 1장 깃 시작하기
# 깃에서 사용가능한 명령어 출력
git 

# 사용자의 이름과 이메일 주소 저장
git config --global user.name "이름"
git config --global user.email "메일 주소"

# 현재 위치의 경로
pwd

# 현재 디렉터리의 파일 & 디렉터리 확인
ls 
ls -l # 상세정보
ls -a # 숨긴 파일 다 표시
ls -r # 파일 정렬 순서 거꾸로 표시
ls -t # 파일 작성 시간순(내림차순) 표시
ls -la # 둘다 사용가능

# 터미널 창 지우기
clear

# 터미널 창에서 디렉터리 이동
# 상위 디렉터리로 이동
cd ..
# 특정 디렉터리로 이동 - cd 디렉터리명
cd Users
cd c:
# 홈 디렉터리로 이동
cd ~

# 하위 디렉터리 생성 - mkdir 디렉터리명
mkdir test

# 하위 디렉터리, 파일 삭제
rm -r test

# 터미널 종료
exit

